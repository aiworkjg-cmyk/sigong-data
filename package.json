{
  "name": "jg-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-site workspace. Each product lives in apps/, shared code in packages/.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "npm run dev --workspace @jg/sigong-upload",
    "build": "npm run build --workspace @jg/sigong-upload",
    "start": "npm run start --workspace @jg/sigong-upload",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
