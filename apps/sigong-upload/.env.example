# ---------------------------------------------------------------------------
# 시공현장 자료 수집·관리 시스템 — 환경변수
#
# 로컬 개발: 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# Azure 배포: App Service > 설정 > 환경 변수(애플리케이션 설정)에 동일하게 등록하고,
#             비밀값은 Key Vault 참조 사용을 권장합니다.
#
# 아무것도 설정하지 않아도 앱은 "테스트 저장 모드" + 로컬 JSON 저장소로 동작합니다.
# ---------------------------------------------------------------------------

# 서버 포트. Azure App Service 는 이 값을 자동으로 주입하므로 배포 시 설정 불필요.
PORT=3000

# 업로드 임시 파일 / 테스트 저장소 / JSON 기록이 저장되는 경로.
# Azure App Service 에서는 재시작 후에도 유지되는 /home/data 를 사용하세요.
DATA_DIR=

# ---------------------------------------------------------------------------
# 마스터 관리자 계정 — 운영 배포 시 필수
#
# 여기 적는 계정이 "마스터" 1개입니다. 나머지 계정(관리자 / 일반)은 로그인 후
# 화면의 [계정 관리] 탭에서 추가하며, 저장소에 보관됩니다.
# 마스터를 환경변수에 두는 이유: 저장소가 깨져도 절대 잠기지 않기 위해서입니다.
#
# 비밀번호를 정하거나 바꾸려면:
#   npm run hash-password --workspace @jg/sigong-upload -- "새비밀번호"
# 출력된 ADMIN_PASSWORD_HASH 를 아래에 붙여넣고 서버를 재시작하면 적용됩니다.
# (ADMIN_SESSION_SECRET 도 함께 출력되지만, 이미 값이 있으면 바꾸지 마세요.
#  바꾸면 로그인 중인 모든 사람이 로그아웃됩니다.)
# 평문 비밀번호는 어디에도 저장되지 않습니다.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=관리자
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# 로그인 세션 유지 시간(시간 단위)
ADMIN_SESSION_HOURS=12

# ---------------------------------------------------------------------------
# Microsoft SharePoint 연동 (미설정 시 자동으로 테스트 저장 모드)
# 설정 절차는 docs/sharepoint-setup.md 참고
# 이름으로 자동 연결하려면 Azure 앱에 Team.ReadBasic.All, Channel.ReadBasic.All과
# (Files.Read.All + Sites.Selected + 사이트별 write) 또는 Files.ReadWrite.All 중 한 방식의
# 응용 프로그램 권한 및 관리자 동의가 필요합니다.
# ---------------------------------------------------------------------------
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# 아래 두 ID는 초기 대상용입니다. 설정 화면의 이름 자동 연결을 사용하면 조회 결과로 대체됩니다.
# SITE_ID 만 있어도 해당 사이트의 기본 문서 라이브러리를 자동으로 찾습니다.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# ---------------------------------------------------------------------------
# Microsoft 업무 계정 로그인 (설정 화면의 [Microsoft 로그인] 버튼)
#
# 앱 권한(응용 프로그램 권한)은 테넌트 관리자만 동의할 수 있어서, 관리자 동의를
# 받기 전에는 팀·채널 조회가 403 으로 막힙니다. 대신 마스터관리자가 본인 업무
# 계정으로 1회 로그인하면 "위임된 권한"으로 본인이 속한 팀을 찾을 수 있고,
# 로그인한 계정은 서버에 기억되어 다음부터는 팀 이름·채널 이름만으로 연결됩니다.
#
# 준비물은 하나뿐입니다 — Azure 포털 > 앱 등록 > [인증] 에서 아래 주소를
# "웹(Web)" 플랫폼 리디렉션 URI 로 등록하세요.
#   http://localhost:3000/api/admin/settings/microsoft/callback   (로컬)
#   https://<배포주소>/api/admin/settings/microsoft/callback       (운영)
#
# 아래 값은 APP_URL 로 자동 구성되므로 보통 비워 둡니다.
# 앱이 실제 공개 주소를 다르게 인식하는 경우에만 전체 주소를 직접 지정하세요.
# ---------------------------------------------------------------------------
MICROSOFT_REDIRECT_URI=

# ---------------------------------------------------------------------------
# 주문서 이미지 판독 (선택) — Azure AI Document Intelligence
#
# 주문서를 "사진"으로 올려 표를 읽어내려면 필요합니다.
# 엑셀(.xlsx) · CSV · 구글시트 연동은 이 설정 없이도 그대로 동작합니다.
#
#   1) Azure 포털에서 [Document Intelligence] 리소스를 만듭니다.
#   2) [키 및 엔드포인트]에서 엔드포인트와 키 1을 복사해 아래에 넣습니다.
#
# 일반 OCR이 아니라 레이아웃 모델을 씁니다. 주문서는 표이고, 셀의 행·열 위치를
# 알아야 어느 값이 어느 열인지 다시 추측하지 않아도 되기 때문입니다.
# ---------------------------------------------------------------------------
AZURE_OCR_ENDPOINT=
AZURE_OCR_KEY=
# 보통 비워 둡니다. Azure가 API 버전을 올렸을 때만 지정하세요.
AZURE_OCR_API_VERSION=

# ---------------------------------------------------------------------------
# 구글시트 연동 — 방법 A: 서비스 계정 (가장 권장, 동의 화면 불필요)
#
# OAuth 는 "동의 화면"을 만들어야 하는데, 개인 Gmail 계정에는 [내부] 선택지가
# 없어 [외부]로 만들 수밖에 없고, 외부 앱을 테스트 모드로 두면 갱신 토큰이
# 7일마다 만료됩니다 — 매주 다시 로그인해야 한다는 뜻입니다.
# 서비스 계정에는 동의 화면도, 만료도, 검증 절차도 없습니다.
#
# 만드는 법 (1회, 약 2분):
#   1) console.cloud.google.com > 프로젝트 만들기
#   2) [API 및 서비스] > [라이브러리] > "Google Sheets API" 사용 설정
#   3) [사용자 인증 정보] > [사용자 인증 정보 만들기] > [서비스 계정]
#      이름만 아무거나 넣고 만들기 (역할 부여 단계는 건너뛰어도 됩니다)
#   4) 만들어진 서비스 계정 클릭 > [키] 탭 > [키 추가] > [새 키 만들기] > JSON
#   5) 내려받은 JSON 파일의 내용 전체를 아래에 한 줄로 붙여넣기
#      (또는 파일을 어딘가 두고 그 경로를 대신 적어도 됩니다)
#
# 그 다음 시트마다 한 번씩:
#   구글시트 [공유] > 서비스 계정 주소(...iam.gserviceaccount.com)를 뷰어로 추가
#   ↳ 주소는 관리자 화면의 [주문서 · 시공현장]에 그대로 표시됩니다.
#   ↳ "링크가 있는 모든 사용자" 공유가 조직 정책으로 막혀 있어도 이건 됩니다.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# 구글시트 연동 — 방법 B: Google 계정 로그인 (선택)
#
# 아래 두 값을 넣으면 관리자 화면에서 [Google 계정 연결] 을 한 번 눌러 로그인할
# 수 있고, 그 다음부터는 시트마다 공유 설정을 바꿀 필요가 없습니다.
# 조직(Workspace)이 "링크가 있는 모든 사용자" 공유를 막아 둔 경우 사실상
# 유일한 방법입니다.
#
# 만드는 법 (1회):
#   1) console.cloud.google.com > 프로젝트 만들기
#   2) [API 및 서비스] > [라이브러리] > "Google Sheets API" 사용 설정
#   3) [OAuth 동의 화면] > 내부(Internal) 선택 > 앱 이름·지원 이메일 입력
#   4) [사용자 인증 정보] > [사용자 인증 정보 만들기] > [OAuth 클라이언트 ID]
#      > 애플리케이션 유형: 웹 애플리케이션
#      > 승인된 리디렉션 URI 에 아래 주소를 그대로 추가:
#          http://localhost:3000/api/admin/work-orders/google/callback   (로컬)
#          https://<배포주소>/api/admin/work-orders/google/callback       (운영)
#   5) 발급된 클라이언트 ID / 보안 비밀번호를 아래에 붙여넣기
#
# 요청하는 권한은 "스프레드시트 읽기" 뿐입니다. 이 앱은 시트를 고칠 수 없습니다.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 보통 비워 둡니다. APP_URL 로 자동 구성됩니다.
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# 계정 연결 없이 쓰려면 환경변수가 필요 없습니다.
#
# 시트를 [공유] > "링크가 있는 모든 사용자" > 뷰어 로 바꾼 뒤, 관리자 화면의
# [주문서 · 시공현장] 에서 주소를 붙여넣으면 됩니다. 서비스 계정이나 OAuth를
# 쓰지 않으므로 구글 클라우드 콘솔을 거칠 일이 없습니다.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 시공종류 — 제출 화면에서 선택 버튼으로 표시됩니다.
# 직접 입력이 아니라 이 목록에서만 고를 수 있고, 서버도 이 목록으로 검증합니다.
# (선택값이 폴더 이름이 되므로 임의 입력을 허용하지 않습니다.)
#
# 이 값은 "최초 1회 초기값"일 뿐입니다. 서버가 처음 켜질 때 저장소에 복사되고,
# 그 다음부터는 관리자 화면 > [설정] 탭에서 추가·삭제한 목록이 사용됩니다.
# 따라서 운영 중에 여기를 고쳐도 화면의 목록은 바뀌지 않습니다.
#
# 시공기사 명부에는 환경변수 초기값이 없습니다. 첫 실행 후 마스터관리자로 로그인해
# [시공기사 관리] 화면에서 이름과 직함(팀장/사수/부사수)을 등록하세요.
# 명부가 비어 있으면 제출 화면에서 시공기사를 고를 수 없습니다.
# ---------------------------------------------------------------------------
CONSTRUCTION_TYPES=백조,인덕션,한샘,이펙스,워너홈

# ---------------------------------------------------------------------------
# 폴더 분류 규칙 (미설정 시 기본값 사용)
#
# 기본: 시공현장자료 / {type} / {yyyy} / {MM}월 / {MMdd}_{addressCompact}
#   예) 시공현장자료/백조/2026/08월/0811_경기광명시하안로60광명SK테크노파크
#
# 사용 가능한 항목:
#   {type}                        시공종류 (백조, 인덕션 ...)
#   {yyyy} {MM} {dd} {MMdd}       연 / 월 / 일 / 월일
#   {date} {yyyy-MM} {quarter}    2026-08-11 / 2026-08 / Q3
#   {address}                     입력한 주소 그대로
#   {addressCompact}              주소에서 공백 제거
#   {sido} {sigungu}              경기 / 광명시
#   {manager} {siteId} {submittedDate}
#
# 예) 시공종류 > 연-월 > 담당자  로 바꾸려면:
#   SHAREPOINT_FOLDER_SEGMENTS={type},{yyyy-MM},{MMdd}_{manager}
# ---------------------------------------------------------------------------
# 비워두면 기본값이 적용됩니다. 끄고 싶을 때만 값을 none 으로 지정하세요.
#   예) 현장정보.json 을 만들지 않으려면:
#       SHAREPOINT_METADATA_FILENAME=none
SHAREPOINT_ROOT_FOLDER=
SHAREPOINT_FOLDER_SEGMENTS=
SHAREPOINT_ATTACHMENTS_FOLDER=
SHAREPOINT_METADATA_FILENAME=
# 관리자 화면에 저장된 값이 우선합니다. 환경변수만으로 지정할 때 사용합니다.
SHAREPOINT_FILE_NAME_TEMPLATE=

# ---------------------------------------------------------------------------
# 업로드 실패 알림 메일 (Microsoft Graph 사용)
#
# SharePoint 연동용 Azure AD 앱에 Mail.Send 애플리케이션 권한을 추가하고
# 관리자 동의를 1회 부여하면 동작합니다. 별도 메일 서비스 가입이 필요 없습니다.
#
#   MAIL_SENDER        : 발신 메일함 (실제 사서함이 있는 계정이어야 함)
#   ADMIN_ALERT_EMAIL  : 수신자. 쉼표로 여러 명 지정 가능
# ---------------------------------------------------------------------------
MAIL_SENDER=
ADMIN_ALERT_EMAIL=
# 메일 본문에 넣을 관리자 화면 주소 (배포 후 실제 주소)
APP_URL=

# ---------------------------------------------------------------------------
# 백그라운드 저장 처리
#
# 제출 즉시 응답하고, 저장소 반영은 뒤에서 진행됩니다.
# 실패 시 아래 횟수만큼 자동 재시도한 뒤 관리자에게 메일이 발송됩니다.
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=1
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_MS=30000

# ---------------------------------------------------------------------------
# SharePoint 수동 업로드 파일 자동 이름 정리
#
# 앱 밖에서 현장 최종 폴더에 직접 올린 파일만 Graph 변경 추적으로 찾아
# 현재 폴더 규칙과 동일한 "폴더명_이미지001.jpg" 형식으로 바꿉니다.
# 최초 실행 시 기존 파일은 건드리지 않고, 그 이후 변경부터 처리합니다.
# 변경이 없을 때는 주기마다 Graph 요청 1회 수준입니다.
# ---------------------------------------------------------------------------
MANUAL_RENAME_ENABLED=true
MANUAL_RENAME_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# Azure Table Storage — 현장 기록 / 업로드 로그 / 이슈 저장소
# 미설정 시 DATA_DIR 아래 로컬 JSON 파일로 대체됩니다.
#
# 둘 중 하나만 설정하세요:
#   1) AZURE_TABLES_CONNECTION_STRING  — 가장 간단
#   2) AZURE_STORAGE_ACCOUNT_NAME      — 관리 ID 사용 (권장, 비밀값 없음)
# ---------------------------------------------------------------------------
AZURE_TABLES_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
# 테이블 이름 접두사 (예: SigongSites, SigongUploadLogs, SigongIssues)
AZURE_TABLES_PREFIX=Sigong

# ---------------------------------------------------------------------------
# 업로드 제한
# ---------------------------------------------------------------------------
MAX_FILES=50
MAX_FILE_SIZE_MB=100
