{
  "name": "@jg/sigong-upload",
  "private": true,
  "version": "1.0.0",
  "description": "시공현장 자료 수집·관리 시스템 — 로그인 없는 현장 자료 제출과 관리자용 로그·이슈 관리",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --outfile=dist/server.cjs --external:express --external:multer --external:dotenv --external:@azure/data-tables --external:@azure/identity --external:vite",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/graph-storage-target.test.ts server/manual-upload-reconciler.test.ts server/settings.test.ts server/order-import.test.ts server/work-orders.test.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "package:azure": "npm run build && node scripts/package-for-azure.mjs"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.0",
    "@azure/identity": "^4.5.0",
    "@jg/sharepoint-core": "*",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
